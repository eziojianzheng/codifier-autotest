{
  "fields": [
    {
      "component": "Card",
      "fields": [
        {
          "component": "Input",
          "componentProps": {
            "inputMode": "numeric"
          },
          "id": "singleLineText",
          "title": "Text",
          "validation": {
            "maxLength": 5,
            "regex": "^[0-9]*$"
          }
        },
        {
          "component": "Textarea",
          "id": "textarea",
          "title": "Textarea",
          "validation": {
            "maxLength": 5
          }
        },
        {
          "component": "NumberPicker",
          "id": "number",
          "title": "Number Picker"
        },
        {
          "component": "DatePicker",
          "id": "date",
          "title": "Date Picker"
        },
        {
          "component": "Upload",
          "componentProps": {
            "deleteWithConfirm": true,
            "listType": "picture-card",
            "maxCount": 2,
            "multiple": true,
            "showCount": true
          },
          "id": "upload",
          "title": "Upload"
        },
        {
          "component": "RichText",
          "id": "richText",
          "title": "Rich Text"
        }
      ]
    },
    {
      "component": "Stack",
      "componentProps": {
        "justifyContent": "flex-end"
      },
      "fields": [
        {
          "component": "Button",
          "componentProps": {
            "action": {
              "successAction": {
                "type": "cancel"
              },
              "type": "submit"
            },
            "content": "Submit",
            "type": "primary"
          }
        },
        {
          "component": "Button",
          "componentProps": {
            "action": {
              "type": "cancel"
            },
            "content": "Cancel"
          }
        }
      ],
      "style": {
        "marginTop": 12
      }
    }
  ],
  "form": {
    "defaultCancelButton": false,
    "defaultSubmitButton": false,
    "labelLayout": "vertical",
    "title": "New"
  }
}