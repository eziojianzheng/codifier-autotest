{
  "fields": [
    {
      "component": "Card",
      "componentProps": {
        "style": {
          "margin": "0 0 20px"
        },
        "title": "Product Information"
      },
      "fields": [
        {
          "component": "Stack",
          "componentProps": {
            "alignItems": "center",
            "flexDirection": "row",
            "gap": 8
          },
          "fields": [
            {
              "component": "Icon",
              "componentProps": {
                "name": "product"
              },
              "style": {
                "background": "rgba(230, 247, 255, 1)",
                "borderRadius": "30px",
                "padding": "8px"
              }
            },
            {
              "component": "Text",
              "componentProps": {
                "content": "Product Details"
              },
              "style": {
                "fontSize": 18,
                "fontWeight": "bold"
              }
            }
          ],
          "style": {
            "margin": "0 0 16px"
          }
        },
        {
          "component": "Grid",
          "componentProps": {
            "colNumber": 3,
            "columnGap": 24,
            "rowGap": 20
          },
          "fields": [
            {
              "component": "Input",
              "id": "productName",
              "title": "Product Name",
              "validation": {
                "maxLength": 100,
                "required": true
              }
            },
            {
              "component": "Input",
              "id": "productCategory",
              "title": "Product Category"
            },
            {
              "component": "Input",
              "id": "productBrand",
              "title": "Product Brand"
            },
            {
              "component": "NumberPicker",
              "id": "costPrice",
              "title": "Cost Price",
              "validation": {
                "minValue": 0
              }
            },
            {
              "component": "NumberPicker",
              "id": "suggestedRetailPrice",
              "title": "Suggested Retail Price",
              "validation": {
                "minValue": 0
              }
            },
            {
              "component": "Input",
              "id": "unit",
              "title": "Unit"
            },
            {
              "component": "NumberPicker",
              "id": "referenceProfitMargin",
              "title": "Reference Profit Margin (%)",
              "validation": {
                "maxValue": 100,
                "minValue": 0
              }
            },
            {
              "component": "Input",
              "id": "productPhotoOne",
              "title": "Product Photo 1"
            },
            {
              "component": "Input",
              "id": "productPhotoTwo",
              "title": "Product Photo 2"
            },
            {
              "component": "Input",
              "id": "productFile",
              "title": "Product File"
            }
          ]
        }
      ]
    },
    {
      "component": "Input",
      "hidden": true,
      "id": "status",
      "title": "Status"
    }
  ],
  "form": {
    "defaultCancelButton": true,
    "defaultSubmitButton": true,
    "title": "Layout"
  }
}