{
  "fields": [
    {
      "component": "Input",
      "hidden": true,
      "id": "status",
      "title": "Status"
    },
    {
      "component": "Card",
      "componentProps": {
        "title": "Electronic Product Information",
        "titleDesc": "Basic product details"
      },
      "fields": [
        {
          "component": "Stack",
