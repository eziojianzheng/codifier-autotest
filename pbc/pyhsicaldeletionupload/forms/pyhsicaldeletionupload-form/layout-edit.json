{
  "fields": [
    {
      "component": "Card",
      "fields": [
        {
          "component": "Input",
          "id": "singleLineText",
          "title": "Text",
          "validation": {
            "maxLength": 200
          }
        },
        {
          "component": "NumberPicker",
          "id": "number",
          "title": "Number Picker"
        },
        {
          "component": "DatePicker",
          "id": "date",
          "title": "Date Picker"
        },
        {
          "component": "Upload",
          "componentProps": {
            "listType": "picture-card"
          },
          "id": "upload",
          "title": "Upload"
        },
        {
          "component": "RichText",
          "id": "richText",
          "title": "Rich Text"
        },
        {
          "component": "Button",
          "componentProps": {
            "action": {
              "method": "delete",
              "type": "request",
              "url": "/flow/api/flow-rest/pysicaldeletion?dataId=:currentData.id"
            },
            "content": "Physical Delete"
          }
        }
      ]
    },
    {
      "component": "Stack",
      "componentProps": {
        "justifyContent": "flex-end"
      },
      "fields": [
        {
          "component": "Button",
          "componentProps": {
            "action": {
              "successAction": {
                "type": "cancel"
              },
              "type": "submit"
            },
            "content": "Submit",
            "type": "primary"
          }
        },
        {
          "component": "Button",
          "componentProps": {
            "action": {
              "type": "cancel"
            },
            "content": "Cancel"
          }
        }
      ],
      "style": {
        "marginTop": 12
      }
    }
  ],
  "form": {
    "defaultCancelButton": false,
    "defaultSubmitButton": false,
    "labelLayout": "vertical",
    "title": "Edit"
  }
}