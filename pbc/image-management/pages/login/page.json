{
  "name": "ログイン画面",
  "schemaId": "login",
  "schemaJson_$$$NESTED_JSON_STRING$$$": {
    "fields": [
      {
        "component": "PageHeader",
        "componentProps": {
          "headerStyle": "style2"
        },
        "style": {
          "color": "#AD0003",
          "margin": 20,
          "textAlign": "center"
        }
      },
      {
        "component": "Stack",
        "componentProps": {
          "alignItems": "stretch",
          "flexDirection": "column",
          "gap": 15,
          "justifyContent": "space-between"
        },
        "fields": [
          {
            "component": "Input",
            "componentProps": {
              "style": {
                "fontSize": "18px"
              }
            },
            "id": "dealerCode",
            "style": {
              "fontSize": "18px"
            },
            "textInputType": "number",
            "title": "販社コード",
            "validation": {
              "maxLength": null,
              "regex": "^[0-9]{3}$",
              "regexErrorMessage": "販社コードは半角数字3桁で入力してください",
              "required": true
            }
          },
          {
            "component": "Input",
            "componentProps": {
              "style": {
                "fontSize": "18px"
              }
            },
            "id": "loginId",
            "style": {
              "fontSize": "18px"
            },
            "textInputType": "text",
            "title": "ログインID",
            "validation": {
              "maxLength": null,
              "regex": "^[0-9a-zA-Z]{1,8}$",
              "regexErrorMessage": "ログインIDは半角英数字1～8桁で入力してください",
              "required": true
            }
          },
          {
            "component": "Password",
            "componentProps": {
              "style": {
                "fontSize": "18px"
              }
            },
            "id": "password",
            "style": {
              "fontSize": "18px"
            },
            "title": "パスワード",
            "validation": {
              "required": true
            }
          },
          {
            "component": "Button",
            "componentProps": {
              "action": {
                "methodName": "loginfunc",
                "successAction": {
                  "href": "/page/search",
                  "type": "link"
                },
                "type": "formMethod"
              },
              "content": "ログイン",
              "style": {
                "height": 60,
                "margin": 10
              },
              "type": "primary"
            },
            "id": "loginButton"
          }
        ],
        "style": {
          "margin": 20
        }
      },
      {
        "component": "Image",
        "componentProps": {
          "src": "https://www.isuzu.co.jp/app-files/img/footer_im01.svg"
        },
        "style": {
          "width": "100%"
        }
      }
    ],
    "form": {
      "browserTitle": {
        "notShowPbcName": true
      },
      "disableDirty": true,
      "hidePageHeader": true,
      "script": "$$$$ref:text:page-form-script.js",
      "style": { },
      "title": "IGS-Mobile"
    }
  }
}