                },
                {
                  "colId": "breed",
                  "field": "breed",
                  "headerName": "Breed",
                  "headerName_i18n_key": "ui-template-maker|>form-template-form|>breed",
                  "type": "TEXT_COLUMN"
                },
                {
                  "colId": "age",
                  "field": "age",
                  "headerName": "Age",
                  "headerName_i18n_key": "ui-template-maker|>form-template-form|>age",
                  "type": "NUMBER_COLUMN"
                },
                {
                  "colId": "gender",
                  "field": "gender",
                  "headerName": "Gender",
                  "headerName_i18n_key": "ui-template-maker|>form-template-form|>gender",
                  "type": "SELECT_COLUMN"
                },
                {
                  "colId": "coatColor",
                  "field": "coatColor",
                  "headerName": "Coat Color",
                  "headerName_i18n_key": "ui-template-maker|>form-template-form|>coatColor",
                  "type": "SELECT_COLUMN"
                },
                {
                  "colId": "weightKg",
