                  "headerName_i18n_key": "ui-template-maker|>form-template-form|>weightKg",
                  "type": "NUMBER_COLUMN"
                },
                {
                  "colId": "lastVaccinationDate",
                  "field": "lastVaccinationDate",
                  "headerName": "Last Vaccination Date",
                  "headerName_i18n_key": "ui-template-maker|>form-template-form|>lastVaccinationDate",
                  "type": "DATE_COLUMN"
                },
                {
                  "colId": "isNeutered",
                  "field": "isNeutered",
                  "headerName": "Neutered",
                  "headerName_i18n_key": "ui-template-maker|>form-template-form|>isNeutered"
                },
                {
                  "colId": "notes",
